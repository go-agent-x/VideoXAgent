{
  "mcpServers": {
    "audio-transcription": {
      "command": "./.venvs/audio/bin/python",
      "args": [
        "./scripts/mcp_runtime.py",
        "./tools/audio/audio-transcription-mcp/server.py"
      ],
      "env": {
        "MCP_ALLOW_MODEL_DOWNLOAD": "0",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "PYTHONUNBUFFERED": "1",
        "HF_HUB_ETAG_TIMEOUT": "8",
        "HF_HUB_DOWNLOAD_TIMEOUT": "20",
        "HF_HUB_DISABLE_TELEMETRY": "1",
        "HF_HUB_DISABLE_PROGRESS_BARS": "1",
        "WHISPERX_MODEL_SIZE": "large-v3",
        "WHISPERX_COMPUTE_TYPE": "float16"
      }
    },
